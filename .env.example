# ==============================================================================
# THE INDULGENT SPOON — ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY — Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Restaurant Default Slug
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=the-indulgent-spoon

# WhatsApp Notifications via TextMeBot (Optional)
TEXTMEBOT_API_KEY=your-textmebot-api-key
TEXTMEBOT_PHONE=your-phone-number
ADMIN_WHATSAPP_NUMBER=your-whatsapp-number

# Razorpay Payment Gateway Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend Transactional Email Configuration
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_resend_api_key
# Default test sender is onboarding@resend.dev; set to verified domain for production
EMAIL_FROM=The Indulgent Spoon <onboarding@resend.dev>
# Kitchen owner email to receive new-order preparation alerts
KITCHEN_OWNER_EMAIL=kitchen-owner@example.com
