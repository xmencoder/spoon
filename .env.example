# ==============================================================================
# THE INDULGENT SPOON — ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase Project URL (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-ONLY — Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Restaurant Default Slug
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=the-indulgent-spoon
