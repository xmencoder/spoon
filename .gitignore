# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & build output
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel & system
.vercel
.DS_Store
Thumbs.db
*.pem

# IDE & agent workspace files
.vscode/
.idea/
.agents/
.gemini/
